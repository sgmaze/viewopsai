---
import HoldingNotice from "../components/HoldingNotice.astro";
import { facts } from "../data/facts";
---

<HoldingNotice
  title={`${facts.brand} · Product revamp in progress`}
  description="ViewOps AI is being rebuilt. AI agents that run back-office work inside your own environment, on a model you host, under guardrails you set."
  trustLine
>
  <Fragment slot="heading">
    We are rebuilding <span class="text-accent">{facts.brand}</span>.
  </Fragment>

  <Fragment slot="body">
    This site is off while the product is revamped. What we are building has not changed: AI agents
    that do back-office work in your real software, inside your own environment, on a model you
    host, under guardrails you set.
  </Fragment>

  <p slot="note" class="mt-6 text-sm text-mute">
    Design partner conversations are open. We reply to every note.
  </p>
</HoldingNotice>
