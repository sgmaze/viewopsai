---
/* The ViewOps AI mark. One definition; callers set the size through class. */
interface Props {
  class?: string;
}

const { class: className = "h-7 w-7" } = Astro.props;
---

<svg viewBox="0 0 120 120" class={className} aria-hidden="true">
  <rect x="4" y="4" width="112" height="112" rx="26" fill="#5aa9ff"></rect>
  <polyline
    points="33,40 60,92 87,40"
    fill="none"
    stroke="#ffffff"
    stroke-width="14"
    stroke-linecap="round"
    stroke-linejoin="round"></polyline>
  <circle cx="60" cy="24" r="8" fill="#ffffff"></circle>
</svg>
